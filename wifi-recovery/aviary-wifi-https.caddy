# Rendered by configure_https.py. HTTPS is served directly by the Pi, including
# offline; Cloudflare is used only to validate/renew the public certificate.
https://SETUP_HOSTNAME {
    tls {
        issuer acme {
            dir ACME_DIRECTORY
            disable_tlsalpn_challenge
        }
    }
    @recovery_clients remote_ip 192.168.4.0/24
    handle @recovery_clients {
        reverse_proxy unix//run/aviary-wifi-recovery/portal.sock {
            header_up X-Aviary-Client-IP {http.request.remote.host}
            header_up X-Aviary-Setup-Scheme https
        }
    }
    handle {
        respond "Not found" 404
    }
}

# Publish ONLY this loopback listener through the tunnel. All non-challenge
# paths fail closed; the setup form and normal Aviary data are not published.
http://:8093 {
    bind 127.0.0.1
    @certificate_validation {
        method GET HEAD
        path_regexp acme_token ^/\.well-known/acme-challenge/[A-Za-z0-9_-]+$
    }
    handle @certificate_validation {
        reverse_proxy http://127.0.0.1:80 {
            header_up Host SETUP_HOSTNAME
            @no_active_token status 3xx 4xx 5xx
            handle_response @no_active_token {
                respond "Not found" 404
            }
        }
    }
    handle {
        respond "Not found" 404
    }
}
