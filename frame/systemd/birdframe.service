[Unit]
Description=Aviary e-ink frame update
Documentation=https://github.com/trevorcreech/Aviary
Wants=network-online.target
After=network-online.target

[Service]
# install.sh rewrites User= and the paths to match your install.
Type=oneshot
User=monalisa
WorkingDirectory=/home/monalisa/Aviary/frame
ExecStart=/home/monalisa/Aviary/frame/.venv/bin/python /home/monalisa/Aviary/frame/display.py --config /home/monalisa/.birdframe/config.toml
Environment=PYTHONUNBUFFERED=1
Nice=10
TimeoutStartSec=300
